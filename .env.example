SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only. Never use a PUBLIC or VITE prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET

# Company Microsoft sign-in. Provider credentials are configured in Supabase Auth.
MICROSOFT_SSO_ENABLED=true
MICROSOFT_TENANT_ID=YOUR_ENTRA_TENANT_ID
MICROSOFT_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_ENTRA_CLIENT_SECRET
# Generate a unique random secret of at least 32 characters; use the same value on Vercel.
ARTIFACT_SIGNING_SECRET=YOUR_RANDOM_SERVER_SECRET
# Optional Vercel Cron authentication secret. If omitted, Vercel's cron header is required.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# Local migrations only; never required by the browser.
SUPABASE_DB_PASSWORD=YOUR_HOORA_DATABASE_PASSWORD
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# Optional path to a replacement trusted Supabase CA certificate after rotation.
# SUPABASE_DB_CA_PATH=/path/to/supabase-root.crt
# Optional server overrides; otherwise the server reads its private database config.
VAPID_PUBLIC_KEY=YOUR_PUBLIC_PUSH_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_PUSH_KEY

# Server-only read-scoped Jira token. Select read:jira-work; never add write scopes.
# Tokens and credentials must never be added to public/config.js or frontend code.
JIRA_READ_EMAIL=YOUR_JIRA_ACCOUNT_EMAIL
JIRA_READ_API_TOKEN=YOUR_READ_SCOPED_ATLASSIAN_API_TOKEN

# Optional AI Gateway token. Server database configuration can also hold the token.
AI_GATEWAY_API_KEY=YOUR_VERCEL_AI_GATEWAY_KEY
