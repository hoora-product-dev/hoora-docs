{
  "entry": [
    "public/app.js",
    "public/theme-init.js",
    "public/sw.js",
    "api/*.js",
    "src/*.js",
    "scripts/*.mjs",
    "tests/*.{mjs,js}"
  ],
  "project": [
    "public/**/*.js",
    "api/**/*.js",
    "server/**/*.js",
    "src/**/*.js",
    "scripts/**/*.{mjs,cjs}",
    "tests/**/*.{mjs,js}"
  ],
  "ignoreDependencies": ["@fontsource-variable/geist", "blobatar"],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [
    "./config.js",
    "/vendor/rich-editor.js",
    "/vendor/uploads.js",
    "/upcoming.js",
    "/lib.js",
    "/vendor/drawing/drawing.js",
    "/ui/feedback.js"
  ]
}
