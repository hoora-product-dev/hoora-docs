{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/ai-index",
      "schedule": "45 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/artifact).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co; frame-src 'self' https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(loader|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/excalidraw/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:file(.*.(?:png|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/upcoming/:slug/tickets/:key",
      "destination": "/index.html"
    },
    {
      "source": "/upcoming/:slug/settings",
      "destination": "/index.html"
    },
    {
      "source": "/contribute/:id",
      "destination": "/index.html"
    },
    {
      "source": "/upcoming",
      "destination": "/api/preview?type=page&page=upcoming"
    },
    {
      "source": "/upcoming/:slug",
      "destination": "/api/preview?type=upcoming&slug=:slug"
    },
    {
      "source": "/install",
      "destination": "/api/preview?type=page&page=install"
    },
    {
      "source": "/home",
      "destination": "/api/preview?type=page&page=home"
    },
    {
      "source": "/release-notes/:version/:application",
      "destination": "/api/preview?type=release&version=:version&application=:application"
    },
    {
      "source": "/docs/:slug",
      "destination": "/api/preview?type=doc&slug=:slug"
    },
    {
      "source": "/releases",
      "destination": "/api/preview?type=page&page=releases"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/api/preview?type=page&page=library"
    },
    {
      "source": "/browse",
      "destination": "/api/preview?type=page&page=library"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/new",
      "destination": "/index.html"
    },
    {
      "source": "/edit/:id",
      "destination": "/index.html"
    },
    {
      "source": "/preview/:id",
      "destination": "/index.html"
    },
    {
      "source": "/artifact/:slug",
      "destination": "/api/preview?type=artifact&slug=:slug"
    },
    {
      "source": "/teams",
      "destination": "/index.html"
    },
    {
      "source": "/teams/:id",
      "destination": "/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/index.html"
    },
    {
      "source": "/contributions",
      "destination": "/index.html"
    },
    {
      "source": "/archive",
      "destination": "/index.html"
    },
    {
      "source": "/activity",
      "destination": "/index.html"
    },
    {
      "source": "/announce",
      "destination": "/index.html"
    },
    {
      "source": "/folders",
      "destination": "/index.html"
    },
    {
      "source": "/users",
      "destination": "/index.html"
    },
    {
      "source": "/permissions",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/requests",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|_next/|assets/|loader/|fonts/|vendor/|editor/|email/|sw\\.js|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/preview.js": {
      "includeFiles": "{dist/index.html,public/loader/*.ttf,public/hoora-mark.png}"
    }
  }
}
